diff --git a/pkg/kvcache/cpu_tier_test.go b/pkg/kvcache/cpu_tier_test.go
new file mode 100644
index 0000000..1f76706
--- /dev/null
+++ b/pkg/kvcache/cpu_tier_test.go
@@ -0,0 +1,120 @@
+/*

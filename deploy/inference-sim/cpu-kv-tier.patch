+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package kvcache
+
+import (
+	"context"
+
+	"github.com/llm-d/llm-d-inference-sim/pkg/common"
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+)
+
+// drainEvents returns the events queued so far (the sender is not running in these tests).
+func drainEvents(bc *blockCache) []EventData {
+	var out []EventData
+	for {
+		select {
+		case ev := <-bc.eventChan.Channel:
+			out = append(out, ev)
+		default:
+			return out
+		}
+	}
+}
+
+var _ = Describe("CPU KV tier", func() {
+	newCache := func(gpuBlocks, cpuBlocks int) *blockCache {
+		config := &common.Configuration{
+			IP: "localhost", Port: 1234, Model: "model", KVCacheSize: gpuBlocks, CPUKVCacheSize: cpuBlocks,
+			EventBatchSize: 1,
+		}
+		bc, err := newBlockCache(context.Background(), config, GinkgoLogr, nil)
+		Expect(err).NotTo(HaveOccurred())
+		return bc
+	}
+	toks := [][]uint32{{1}, {2}, {3}}
+
+	It("writes computed blocks through to the CPU tier and loads them back after GPU eviction", func() {
+		bc := newCache(4, 8)
+		req1 := testRequest{id: "r1", model: "model", blockHashes: []uint64{1, 2, 3}, tokens: toks}
+		cached, loaded, err := bc.startRequestTiered(&req1, req1.blockHashes, req1.tokens)
+		Expect(err).NotTo(HaveOccurred())
+		Expect([]int{cached, loaded}).To(Equal([]int{0, 0}))
+		Expect(bc.finishRequest("r1")).To(Succeed())
+
+		events := drainEvents(bc)
+		Expect(events).To(HaveLen(2)) // GPU store, then CPU store of the same chain
+		Expect(events[0].deviceTier()).To(Equal(GPU))
+		Expect(events[1].deviceTier()).To(Equal(CPU))
+		Expect(events[1].hashes).To(Equal([]uint64{1, 2, 3}))
+		Expect(events[1].parentHash).To(BeNil())
+
+		// 3 new blocks into a 4-block GPU tier holding 3 unused ones: evicts 3 and 2 (released tail first)
+		req2 := testRequest{id: "r2", model: "model", blockHashes: []uint64{4, 5, 6}, tokens: toks}
+		_, _, err = bc.startRequestTiered(&req2, req2.blockHashes, req2.tokens)
+		Expect(err).NotTo(HaveOccurred())
+		Expect(bc.finishRequest("r2")).To(Succeed())
+		drainEvents(bc)
+
+		_, gpuHasHead := bc.getBlockInfo(blockKey{hash: 1, modelName: "model"})
+		Expect(gpuHasHead).To(BeTrue())
+
+		// 1 is still on the GPU, 2 and 3 come back from the CPU tier
+		req3 := testRequest{id: "r3", model: "model", blockHashes: []uint64{1, 2, 3}, tokens: toks}
+		cached, loaded, err = bc.startRequestTiered(&req3, req3.blockHashes, req3.tokens)
+		Expect(err).NotTo(HaveOccurred())
+		Expect([]int{cached, loaded}).To(Equal([]int{1, 2}))
+		for _, ev := range drainEvents(bc) {
+			Expect(ev.deviceTier()).To(Equal(GPU)) // loads add GPU copies; the CPU tier already has them
+		}
+	})
+
+	It("evicts least recently used CPU blocks and announces the removal", func() {
+		bc := newCache(8, 4)
+		req1 := testRequest{id: "r1", model: "model", blockHashes: []uint64{1, 2, 3}, tokens: toks}
+		_, _, err := bc.startRequestTiered(&req1, req1.blockHashes, req1.tokens)
+		Expect(err).NotTo(HaveOccurred())
+		req2 := testRequest{id: "r2", model: "model", blockHashes: []uint64{4, 5}, tokens: toks[:2]}
+		_, _, err = bc.startRequestTiered(&req2, req2.blockHashes, req2.tokens)
+		Expect(err).NotTo(HaveOccurred())
+
+		events := drainEvents(bc)
+		last := events[len(events)-1]
+		Expect(last.action).To(Equal(eventActionRemove))
+		Expect(last.deviceTier()).To(Equal(CPU))
+		Expect(last.hashes).To(Equal([]uint64{1}))
+		Expect(bc.cpuLRU.Len()).To(Equal(4))
+		Expect(events[len(events)-2].parentHash).To(BeNil()) // r2's chain starts a new sequence
+	})
+
+	It("keeps the GPU tier's oldest-first eviction with the list-based index", func() {
+		bc := newCache(3, 0)
+		for i, hash := range []uint64{1, 2, 3} {
+			req := testRequest{id: string(rune('a' + i)), model: "model", blockHashes: []uint64{hash}, tokens: toks[:1]}
+			_, err := bc.startRequest(&req, req.blockHashes, req.tokens)
+			Expect(err).NotTo(HaveOccurred())
+			Expect(bc.finishRequest(req.id)).To(Succeed())
+		}
+		Expect(bc.pickBlockToEvict().hash).To(Equal(uint64(1)))
+		req := testRequest{id: "x", model: "model", blockHashes: []uint64{1}, tokens: toks[:1]}
+		_, err := bc.startRequest(&req, req.blockHashes, req.tokens) // reuses 1
+		Expect(err).NotTo(HaveOccurred())
+		Expect(bc.pickBlockToEvict().hash).To(Equal(uint64(2)))
+		Expect(bc.cpuLRU.Len()).To(Equal(0))
+	})
+})

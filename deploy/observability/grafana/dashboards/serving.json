{
 "uid": "maxionbench-serving",
 "title": "MaxionBench serving",
 "schemaVersion": 41,
 "version": 1,
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "refresh": "5s",
 "tags": [
  "maxionbench"
 ],
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Gateway requests/s by backend",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (backend) (rate(maxion_gateway_requests_total[30s]))",
     "legendFormat": "{{backend}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Route decisions/s by reason",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (backend, reason) (rate(maxion_gateway_route_decisions_total[30s]))",
     "legendFormat": "{{backend}}:{{reason}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Predicted local wait (local_first_slo)",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "maxion_gateway_predicted_local_wait_seconds",
     "legendFormat": "predicted wait"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "In-flight by backend",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "maxion_gateway_inflight",
     "legendFormat": "{{backend}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Upstream time to first byte",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le, backend) (rate(maxion_gateway_upstream_ttfb_seconds_bucket[1m])))",
     "legendFormat": "p50 {{backend}}"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le, backend) (rate(maxion_gateway_upstream_ttfb_seconds_bucket[1m])))",
     "legendFormat": "p95 {{backend}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Remote spend and remaining budget",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "maxion_gateway_remote_spend_usd_total",
     "legendFormat": "spend"
    },
    {
     "refId": "B",
     "expr": "maxion_gateway_budget_remaining_usd",
     "legendFormat": "remaining"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "vLLM running / waiting requests",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "vllm:num_requests_running",
     "legendFormat": "running {{instance}}"
    },
    {
     "refId": "B",
     "expr": "vllm:num_requests_waiting",
     "legendFormat": "waiting {{instance}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "vLLM TTFT",
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, instance) (rate(vllm:time_to_first_token_seconds_bucket[1m])))",
     "legendFormat": "p95 {{instance}}"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "vLLM prefix cache hit rate",
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(vllm:prefix_cache_hits_total[1m]) / rate(vllm:prefix_cache_queries_total[1m])",
     "legendFormat": "{{instance}}"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "llama.cpp processing / deferred",
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "llamacpp:requests_processing",
     "legendFormat": "processing {{instance}}"
    },
    {
     "refId": "B",
     "expr": "llamacpp:requests_deferred",
     "legendFormat": "deferred {{instance}}"
    }
   ]
  }
 ]
}
